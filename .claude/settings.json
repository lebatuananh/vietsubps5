{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|compact|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/reload-after-compact.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-worker-session.js\""
          }
        ]
      }
    ]
  }
}
